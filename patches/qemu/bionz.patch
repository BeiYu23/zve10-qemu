+/* ---- CXD90045: ATAGS + 带寄存器的跳板 ----
+ * 原来模型的跳板只设 PC，r1/r2 都是 0，内核因此拿不到 machine type 和 atags，
+ * 也就拿不到 initrd。这里补一个最小 ATAGS（CORE + INITRD2 + CMDLINE + NONE），
+ * 并让跳板在跳转前把 r1=MACH_TYPE、r2=atags 装好。
+ * MACH_TYPE_CXD900X0 = 3497
+ */
+#define CXD90045_ATAGS_BASE   0x00010000u  /* 必须在第一 MB 内：早期页表只映射低地址 */
+#define ATAG_CORE             0x54410001u
+#define ATAG_INITRD2          0x54420005u
+#define ATAG_CMDLINE          0x54410009u
+#define ATAG_NONE             0x00000000u
+
+static void cxd90045_build_atags(hwaddr base, hwaddr initrd_start, hwaddr initrd_size, const char *cl)
+{
+    static uint8_t buf[0x1000];
+    uint32_t *p = (uint32_t *)buf;
+    if (!cl || !*cl)
+        cl = "console=ttyAM0,115200n8";
+
+    *p++ = 2; *p++ = ATAG_CORE;
+    if (initrd_start && initrd_size) {
+        *p++ = 4; *p++ = ATAG_INITRD2;
+        *p++ = (uint32_t)initrd_start; *p++ = (uint32_t)initrd_size;
+    }
+    {
+        size_t len = strlen(cl) + 1;
+        size_t words = (len + 3) / 4;
+        *p++ = 2 + words; *p++ = ATAG_CMDLINE;
+        memset(p, 0, words * 4);
+        memcpy(p, cl, len);
+        p += words;
+    }
+    *p++ = 0; *p++ = ATAG_NONE;
+
+    rom_add_blob_fixed("atags", buf, (size_t)((uint8_t *)p - buf), base);
+}
+
+static void cxd90045_bootloader(hwaddr base, hwaddr target, hwaddr atags)
+{
+    uint32_t l[] = {
+        0xe3a00000,              /* mov  r0, #0                */
+        0xe59f1004,              /* ldr  r1, [pc, #4]  -> 3497 */
+        0xe59f2004,              /* ldr  r2, [pc, #4]  -> atags*/
+        0xe59ff004,              /* ldr  pc, [pc, #4]  -> target*/
+        3497,                    /* MACH_TYPE_CXD900X0 */
+        (uint32_t)atags,
+        (uint32_t)target,
+    };
+    int i;
+    for (i = 0; i < ARRAY_SIZE(l); i++)
+        l[i] = tswap32(l[i]);
+    rom_add_blob_fixed("bootloader", l, sizeof(l), base);
+}
