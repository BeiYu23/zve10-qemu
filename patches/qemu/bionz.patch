+/* ---- WBI（Warm Boot Image）装载 ----
+ * 真机 cmdline 的 wbimem=<size>@<addr> 是段表：
+ *   0x1000@0x20021000  0xEC000@0x20028000  0x8000@0x20145000
+ *   0x500000@0x03085000  0x96D000@0x11000000
+ *   0x2A48000@0x20200000  0x200000@0x23E00000
+ * 合计 ≈59.7MB ≈ nflasha5(60MB)，即 nflasha5 是这些段的顺序拼接。
+ * 真机由引导器搬进内存；-kernel 直载会跳过它 ⇒ backup.ko 拿不到
+ * ft_backup/cp_backup（backup_init: file_load 失败）⇒ Backup_* 缺失
+ * ⇒ 约 20 个模块连锁失败。这里补上引导器这一步。
+ */
+static const struct { uint32_t size, addr; } cxd90045_wbi_segs[] = {
+    { 0x001000, 0x20021000 }, { 0x0EC000, 0x20028000 },
+    { 0x008000, 0x20145000 }, { 0x500000, 0x03085000 },
+    { 0x96D000, 0x11000000 }, { 0x2A48000, 0x20200000 },
+    { 0x200000, 0x23E00000 },
+};
+
+static void cxd90045_load_wbi(BlockBackend *blk)
+{
+    hwaddr src = 2 * 0x200000 + 0x05800000;   /* 用户区里的 nflasha5 */
+    uint8_t *buf;
+    int64_t off = src;
+    uint32_t i;
+
+    if (!blk) {
+        return;
+    }
+    buf = g_malloc(64 * 1024);
+    for (i = 0; i < ARRAY_SIZE(cxd90045_wbi_segs); i++) {
+        uint32_t sz = cxd90045_wbi_segs[i].size;
+        hwaddr dst = cxd90045_wbi_segs[i].addr;
+        uint32_t done = 0;
+        while (done < sz) {
+            uint32_t chunk = MIN((uint32_t)(64 * 1024), sz - done);
+            if (blk_pread(blk, off, buf, chunk) < 0) {
+                g_free(buf);
+                return;
+            }
+            rom_add_blob_fixed("wbi", buf, chunk, dst + done);
+            off += chunk;
+            done += chunk;
+        }
+    }
+    g_free(buf);
+    fprintf(stderr, "ZZWBI: loaded %u segments from nflasha5\n",
+            (unsigned)ARRAY_SIZE(cxd90045_wbi_segs));
+}
