+            /* +12 CID (16B) */ 0x4b000115, 0x47344d4c, 0x50454631, 0x3332d144,
+            /* +28 CSD (16B) */ 0xd00f5903, 0x2d0f7fff, 0x0a400000, 0x01000000,
+            /* +44 */ 0x00000000, 0x00000000, 0x00000000, 0x00000000,
