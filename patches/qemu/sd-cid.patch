 static void sd_set_cid(SDState *sd)
 {
+    if (sd->emmc) {
+        /* eMMC 的 CID 布局与 SD 不同：PNM 是 6 字节（SD 是 5 字节），
+         * 后面 PRV/PSN/MDT 整体后移一字节。原实现按 SD 布局写，
+         * 导致索尼 emmc.ko 解析出的 PRV/PSN/MDT 全部错位，型号永远匹配不上。
+         * 这里给出 Samsung KLM8G1WEPD 的 CID：
+         *   MID=0x15 OID=0x0001 -> emmc.ko 计算的 cid_id = 0x0115
+         *   PNM = "R3DPW8"      -> 命中型号表 [0]
+         */
+        static const uint8_t pnm[6] = { 'R', '3', 'D', 'P', 'W', '8' };
+        int i;
+        sd->cid[0] = 0x15;	/* MID: Samsung */
+        sd->cid[1] = 0x00;	/* OID[15:8] */
+        sd->cid[2] = 0x01;	/* OID[7:0] */
+        for (i = 0; i < 6; i++) {
+            sd->cid[3 + i] = pnm[i];
+        }
+        sd->cid[9] = PRV;		/* PRV */
+        sd->cid[10] = 0xde;		/* PSN */
+        sd->cid[11] = 0xad;
+        sd->cid[12] = 0xbe;
+        sd->cid[13] = 0xef;
+        sd->cid[14] = ((MDT_YR % 10) << 4) | MDT_MON;
+        sd->cid[15] = (sd_crc7(sd->cid, 15) << 1) | 1;
+        return;
+    }
     sd->cid[0] = MID;		/* Fake card manufacturer ID (MID) */
     sd->cid[1] = OID[0];	/* OEM/Application ID (OID) */
     sd->cid[2] = OID[1];
@@ -422,7 +447,14 @@ static void sd_set_ext_csd(SDState *sd, uint64_t size)
     sd->ext_csd[214] = (sectcount >> 16) & 0xff; /* ... */
     sd->ext_csd[213] = (sectcount >> 8) & 0xff;  /* ... */
     sd->ext_csd[212] = (sectcount & 0xff);       /* ... */
-    sd->ext_csd[196] = 0x3f; /* Device type */
+    /* Device type (EXT_CSD[196]):
